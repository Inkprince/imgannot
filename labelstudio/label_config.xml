<View>
  <Header value="Boxes for every object; polygons too for person on images listed in data/polygon_subset.txt"/>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>

  <RectangleLabels name="box" toName="image" strokeWidth="2">
    <Label value="person" background="#e6194b" hotkey="1"/>
    <Label value="two_wheeler" background="#3cb44b" hotkey="2"/>
    <Label value="vehicle" background="#4363d8" hotkey="3"/>
  </RectangleLabels>

  <PolygonLabels name="poly" toName="image" strokeWidth="2" pointSize="small" opacity="0.3">
    <Label value="person" background="#e6194b"/>
  </PolygonLabels>

  <Choices name="flags" toName="image" choice="multiple" showInline="true">
    <Choice value="No objects" hint="Tick only if the image truly has nothing to label"/>
  </Choices>
</View>
